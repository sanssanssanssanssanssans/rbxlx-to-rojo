					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local module = {}
local key = "908h23h8fehfhwodfseoifiohjwehfhwehefhefiheduifsidfijajj4w929j23jrj2390fj39fj"

function module:process(input)
	local out = ""
	for i = 1, #input do
		local charcode = string.byte(input, i)
		local keyidx = ((i - 1) % #key) + 1
		local keycode = string.byte(key, keyidx)
		
		local processed = bit32.bxor(charcode,keycode)
		out = out .. string.char(processed)
	end
	return out
end

function module:encrypt(input)
	return self:process(input)
end

function module:decrypt(input)
	return self:process(input)
end

return module]]></ProtectedString>
