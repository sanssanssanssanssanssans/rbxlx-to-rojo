		<Item class="Script" referent="RBXC29D9CD4AB1F4EC2848C28268AD04EA9">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local xorencrypt = require(game.ReplicatedStorage.package.sec.xorencryptor)
local module = {}
module.__index = {}

local mathev = game.ReplicatedStorage.MathEvent
local verify = game.ReplicatedStorage.VerifyAnswer

function module.init()
	verify.OnServerInvoke = function(plr,enc,plra)
		local dec = xorencrypt:decrypt(enc)
		if tostring(plra) == dec then
			return true
		end
		return false
	end
end

function module.get_rand(zone)
	local zonefolder = game.ReplicatedStorage.DB:FindFirstChild("zones"..zone)
	if not zonefolder then
		return nil
	end
end]]></ProtectedString>
