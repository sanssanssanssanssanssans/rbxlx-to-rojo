			<Item class="ModuleScript" referent="RBX0F75DB553E6B479E96B8A014BECE0DAD">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local module = {}
module.__index = module

function module.new(zone : Part, diff : string)
	local self = setmetatable({}, module)
	self.Part = zone
	self.Diff = diff
end

function module:is_player_inzone(pos)
	local part = self.Part
	local offset = part.CFrame:PointToObjectSpace(pos)
	
	return math.abs(offset.X) <= part.Size.X / 2
		and math.abs(offset.Y) <= part.Size.Y / 2
		and math.abs(offset.Z) <= part.Size.Z / 2
end

function module:get_diff()
	return self.Diff
end

return module
]]></ProtectedString>
